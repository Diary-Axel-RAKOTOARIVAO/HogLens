  <TextView android:id="@+id/widget_visitors" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:layout_marginTop="2dp" android:textColor="@color/widget_text" android:textSize="26sp" android:textStyle="bold" />
  <TextView android:id="@+id/widget_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_muted" android:textSize="11sp" />
</LinearLayout>