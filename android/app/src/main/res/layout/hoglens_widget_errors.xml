<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/hoglens_widget_bg" android:orientation="vertical" android:padding="14dp">
  <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:letterSpacing="0.12" android:maxLines="1" android:textAllCaps="true" android:textColor="@color/widget_muted" android:textSize="10sp" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="bottom" android:orientation="horizontal">
    <TextView android:id="@+id/widget_errors" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#EF4444" android:textSize="32sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_caption" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginBottom="3dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_muted" android:textSize="11sp" />
  </LinearLayout>
  <TextView android:id="@+id/widget_top_error" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:ellipsize="end" android:maxLines="3" android:textColor="@color/widget_text" android:textSize="11sp" />
  <TextView android:id="@+id/widget_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_faint" android:textSize="10sp" />
</LinearLayout>